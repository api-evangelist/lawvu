        {
          "info": {
            "name": "Get contracts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-sandbox.lawvu.com/account-apis/v2/contracts",
            "params": [
              {
                "name": "$filter",
                "value": "",
                "type": "query",
                "description": "Filter the results using OData filter syntax"
              },
              {
                "name": "$orderby",
                "value": "",
                "type": "query",
                "description": "Order the results using OData orderby syntax"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query",
                "description": "Skip the specified number of results"
              },
              {
                "name": "$top",
                "value": "",
                "type": "query",
                "description": "Limit the number of results returned"
              }
            ]
          },
          "docs": "Retrieve a list of contracts"
        },
        {
          "info": {
            "name": "Create contract",
