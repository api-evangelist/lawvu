          "http": {
            "method": "GET",
            "url": "https://api-sandbox.lawvu.com/account-apis/v2/contractTypes",
            "params": [
              {
                "name": "$skip",
                "value": "",
                "type": "query",
                "description": "Specifies the number of items to skip"
              },
              {
                "name": "$top",
                "value": "",
                "type": "query",
                "description": "Specifies the maximum number of items to return"
              }
            ]
          },
          "docs": "Retrieve a list of contract types"
